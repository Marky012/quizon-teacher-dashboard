# The teacher's Supabase project.
#
# Copy this file to `.env` (git ignored) and fill it in. The values come
# from Supabase > Project Settings > API.
#
# Both values are PUBLIC. They are in the shipped JavaScript and anyone can
# read them. That is not a leak: the anon key identifies the project, and
# Row Level Security decides what it may read. The service-role key, which
# bypasses RLS, lives ONLY in the edge function and never appears here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
